#!/usr/bin/env ruby
# tap-audit

# 20260824
# 0.13.0

require 'json'
require 'switches.rb'

DEFAULT_BRANCH = 'master'
DEFAULT_CONFIG_FILEPATH = File.join('~', '.config', 'tap-audit', 'config.json')
DEFAULT_BREW_PREFIX = '/opt/homebrew'
DEFAULT_REPOSITORIES_DIRECTORY = File.expand_path('..')
DEFAULT_SEARCH_PATH = ENV['PATH'].to_s
DEFAULT_TAP_DIRECTORY = File.expand_path('.')
STANDARD_GITIGNORE_LINES = 47
UNINSTALLED_DIRECTORIES = %w{doc spec test}

def usage
  puts "tap-audit - Report what each formula in the tap has drifted from."
  puts
  puts "Usage: tap-audit [options]"
  puts
  puts "Options:"
  puts "  -c, --config FILE       Where the configuration is (default: #{DEFAULT_CONFIG_FILEPATH})"
  puts "  -r, --repositories DIR  Where the source repositories are (default: the configured one, else ..)"
  puts "  -f, --formulae DIR      Where the formulae are (default: the configured one, else .)"
  puts "  -s, --search-path PATH  Colon-separated directories, searched in order (default: $PATH)"
  puts "  -b, --brew-prefix DIR   Where Homebrew keeps bin (default: #{DEFAULT_BREW_PREFIX})"
  puts "  -B, --branch NAME       The branch each repository releases from (default: #{DEFAULT_BRANCH})"
  puts "  -o, --origin            Ask origin what a pinned build would fetch (one call each)"
  puts "  -h, --help              Show this help"
  puts
  puts "Exits 1 where anything was found, so it can gate a release."
end

def switches
  @switches ||= Switches.new do |s|
    s.optional(:c, :config){'Where the configuration is'}
    s.optional(:r, :repositories){'Where the source repositories are'}
    s.optional(:f, :formulae){'Where the formulae are'}
    s.optional(:s, :search_path, default: DEFAULT_SEARCH_PATH){'Colon-separated directories, searched in order'}
    s.optional(:b, :brew_prefix, default: DEFAULT_BREW_PREFIX){'Where Homebrew keeps bin'}
    s.optional(:B, :branch, default: DEFAULT_BRANCH){'The branch each repository releases from'}
    s.boolean(:o, :origin){'Ask origin what a pinned build would fetch'}
    s.perform(:h, :help?) do
      usage
      exit
    end
  end
end

def config_filepath
  File.expand_path(switches.config || DEFAULT_CONFIG_FILEPATH)
end

# Absent is legitimate rather than an error: a tap is a repository, so tap-audit
# run from within one needs no configuration at all, and what it installs from
# sits beside it.  A configuration is how a tap kept somewhere else is said once
# rather than upon every run.
def config
  @config ||= (
    if File.exist?(config_filepath)
      JSON.parse(File.read(config_filepath), symbolize_names: true)
    else
      {}
    end
  )
end

def repositories_directory
  @repositories_directory ||= File.expand_path(switches.repositories || config[:repositories] || DEFAULT_REPOSITORIES_DIRECTORY)
end

def formulae_directory
  @formulae_directory ||= File.expand_path(switches.formulae || config[:formulae] || DEFAULT_TAP_DIRECTORY)
end

def validate_directories
  [repositories_directory, formulae_directory].each do |directory|
    unless Dir.exist?(directory)
      $stderr.puts "No such directory: #{directory}"
      exit 1
    end
  end
end

def formula_paths
  @formula_paths ||= Dir[File.join(formulae_directory, '*.rb')].sort
end

def formula_name(path)
  File.basename(path, '.rb')
end

def formula_source(path)
  @formula_sources ||= {}
  @formula_sources[path] ||= File.read(path)
end

def declared_version(path)
  formula_source(path)[/^\s*version '([^']+)'/, 1]
end

def declared_tag(path)
  formula_source(path)[/^\s*url .*tag: '([^']+)'/, 1]
end

def declared_url(path)
  formula_source(path)[/^\s*url '([^']+)'/, 1]
end

def declared_homepage(path)
  formula_source(path)[/^\s*homepage '([^']+)'/, 1]
end

def repository_named(url)
  url.to_s[%r{github\.com[:/]thoran/([^/]+?)(?:\.git)?/?\z}, 1]
end

# A formula reaches the keg by more than .install: moby copied its lib in with
# FileUtils.cp_r, which 0.0.0 did not read and so reported a lib named by no
# install line where the lib was in fact installed, wrongly and by another
# means.  Anything which puts a path into the keg is an install line here.
# Commented-out lines are not, and skyhooks carries four of them.
def install_lines(path)
  formula_source(path).lines.reject{|line| line.strip.start_with?('#')}.select{|line| line =~ /\.install\b|\bcp_r?\b|\bmv\b|\bln_s\b/}
end

# Both quotings, since an interpolated path cannot be single-quoted and
# FileUtils.cp_r("#{pwd}/lib", lib) is how the one which was missed was written.
def quoted_strings(line)
  line.scan(/'([^']*)'|"([^"]*)"/).flatten.compact
end

# What is left of a string once the interpolations are dropped, being the part
# which names a path within the repository.  "#{pwd}/lib" is lib, and a leading
# separator left behind by the interpolation is not a path from the root.
def repository_relative(string)
  string.gsub(/\#\{[^}]*\}/, '').sub(%r{\A/+}, '').sub(%r{/+\z}, '')
end

# The lines of def install, comments and blanks dropped.  The end which closes
# the method is the one at the method's own indent, a deeper one closing a block
# within it.
def install_body(path)
  @install_body ||= {}
  @install_body[path] ||= (
    body = []
    depth = nil
    formula_source(path).lines.each do |line|
      if depth.nil?
        depth = line[/\A */].length if line =~ /^\s*def install\b/
        next
      end
      break if line =~ /\A\s{#{depth}}end\s*\z/
      body << line
    end
    body.reject{|line| line.strip.empty? || line.strip.start_with?('#')}
  )
end

# A statement is finished where nothing is left open and nothing is left
# dangling.  Three things carry a statement onto the next line here:
# write_env_script's parentheses, resources.each's do, and the trailing comma of
# a system call's argument list.  Each of the three is in the tap already, and a
# statement rejoined wrongly is a statement reported as unrecognised, so this
# decides the false positives rather than the whitelist does.
def continued?(text)
  text.count('(') != text.count(')') ||
    text.count('{') != text.count('}') ||
    text.scan(/\bdo\b/).length != text.scan(/\bend\b/).length ||
    text.strip.end_with?(',')
end

def logical_lines(lines)
  statements = []
  pending = ''
  lines.each do |line|
    pending += line
    next if continued?(pending)
    statements << pending.strip
    pending = ''
  end
  statements << pending.strip unless pending.strip.empty?
  statements
end

INSTALL_IDIOMS = [
  /\.install\b/,
  /\bFileUtils\.\w+/,
  /\Asystem\b/,
  /\AENV\[/,
  /\Aresources\b/,
  /\bwrite_env_script\b/,
]

def recognised?(statement)
  INSTALL_IDIOMS.any?{|idiom| statement =~ idiom}
end

# The check which finds a FileUtils.cp_r without anyone having thought of
# FileUtils.cp_r.  What def install does decides what reaches the keg, so a
# statement this cannot classify is one whose effect upon the keg is unknown,
# and saying so is the whole of the job.  Silence in its place is how 0.0.0
# reported moby's lib as named by no install line while it was being installed
# by a means not looked for.
def unrecognised_findings(path)
  logical_lines(install_body(path)).reject{|statement| recognised?(statement)}.collect do |statement|
    "unrecognised in def install, so what it puts in the keg is unknown: #{statement.lines.first.strip}"
  end
end

def installed_paths(path)
  install_lines(path).flat_map{|line| quoted_strings(line)}.collect{|s| repository_relative(s)}.reject(&:empty?)
end

def repository_path(name)
  File.join(repositories_directory, name)
end

def repository?(name)
  Dir.exist?(File.join(repository_path(name), '.git'))
end

def git(name, *arguments)
  IO.popen(['git', '-C', repository_path(name), *arguments], err: File::NULL, &:read)
end

# For the questions git answers by exit status rather than upon stdout.
def git?(name, *arguments)
  system('git', '-C', repository_path(name), *arguments, out: File::NULL, err: File::NULL)
end

def tags(name)
  git(name, 'tag', '--list').lines.map(&:strip)
end

# The top-level directory of every tracked file, which is what an install line
# names.  A file tracked at the root belongs to no directory and is left out.
def repository_directories(name)
  git(name, 'ls-files').lines.map{|path| path.strip.split('/').first if path.include?('/')}.compact.uniq.sort
end

def changelog_path(name)
  Dir[File.join(repository_path(name), 'CHANGELOG*')].first
end

# The newest entry, the CHANGELOGs being written newest-first and the version
# test in each repository asserting that the two agree.
def repository_version(name)
  return nil unless changelog_path(name)
  File.read(changelog_path(name))[/^(\d+\.\d+\.\d+):/, 1]
end

# A version's summary is written once and copied twice: into the CHANGELOG and
# into the commit which made it.  Nothing holds the two together, so an edit to
# either leaves the other saying something else, and neither file is wrong on
# its own.  Eleven of the tap's repositories carried a summary rewritten in one
# place and not the other.
def changelog_summaries(name)
  return [] unless changelog_path(name)
  File.readlines(changelog_path(name)).collect(&:chomp).grep(/\A\d+\.\d+\.\d+: /)
end

def commit_summaries(name)
  git(name, 'log', '--format=%s').lines.collect(&:chomp).grep(/\A\d+\.\d+\.\d+: /)
end

def summary_version(line)
  line[/\A(\d+\.\d+\.\d+):/, 1]
end

# A CHANGELOG stating no summary in the form at all is one file to correct
# rather than one finding per version: weblink writes the version and date upon
# one line and the summary upon the next, so every commit there looks orphaned.
def unreadable_changelog_finding(name)
  return nil unless changelog_path(name)
  return nil unless changelog_summaries(name).empty?
  return nil if commit_summaries(name).empty?
  'summary: the CHANGELOG states no summary in the form "X.Y.Z: ...", so none can be compared against the commits'
end

def entry_written(name, version)
  git(name, 'log', '--format=%h %ad', '--date=short', '--reverse', '-S', "#{version}: ", '--', File.basename(changelog_path(name))).lines.first.to_s.split
end

def summary_written(name, version)
  line = git(name, 'log', '--format=%h %ad %s', '--date=short').lines.find do |entry|
    entry.split(' ', 3).last.to_s.start_with?("#{version}: ")
  end
  line.to_s.split(' ', 3).first(2)
end

# Which text came first, and whether both were written at once.  A release which
# recorded itself inconsistently is a different fault from a record reconstructed
# afterwards which disagrees with a contemporary one, and the dates are the only
# thing here which tells the two apart.
#
# Neither settles which text is right, and the tool does not say: moby's
# CHANGELOG is the better record and gem-publish's commit is, and in both the
# commit came first by a long way.  What is reported is when each was written.
#
# A line apiece, oldest first, rather than both upon one: the two texts are what
# is being compared, and moby's run to two hundred characters before the dates
# are added to them.
def summary_disagreement(name, version, said, entry)
  written = summary_written(name, version)
  written_entry = entry_written(name, version)
  lines = [['commit', said, written], ['CHANGELOG', entry, written_entry]]
  return "summary: #{version} disagrees\n    commit     #{said.inspect}\n    CHANGELOG  #{entry.inspect}" if written.empty? || written_entry.empty?
  header = written.first == written_entry.first ? "summary: #{version} disagrees, both written in #{written.first}" : "summary: #{version} disagrees, oldest first"
  body = lines.sort_by{|_label, _text, at| at.last.to_s}.collect{|label, text, at| "    #{at.last}  #{label.ljust(9)}  #{text.inspect}"}
  ([header] + body).join("\n")
end

def summary_findings(name)
  return [] unless changelog_path(name)
  return [] if changelog_summaries(name).empty?
  entries = changelog_summaries(name)
  messages = commit_summaries(name)
  versions = (entries + messages).collect{|line| summary_version(line)}.uniq.sort_by{|version| Gem::Version.new(version)}
  versions.filter_map do |version|
    entry = entries.find{|line| summary_version(line) == version}
    said = messages.select{|line| summary_version(line) == version}
    next if said.length == 1 && said.first == entry
    next "summary: #{version} is the version of #{said.length} commits" if said.length > 1
    next "summary: #{version} is in the CHANGELOG and no commit says it" if said.empty?
    next "summary: #{version} is in a commit and not the CHANGELOG" if entry.nil?
    summary_disagreement(name, version, said.first, entry)
  end
end

# Every version a repository states is one something might be pinned to, and a
# formula can only name a tag which exists.  The declared version is reported
# apart from the rest because it is the one which stops the formula being
# pinned at all; moby states forty-eight versions and tags eleven, so listing
# each would bury that.
def repository_versions(name)
  (changelog_summaries(name) + commit_summaries(name)).collect{|line| summary_version(line)}.uniq
end

def tagged_versions(name)
  tags(name).collect{|tag| tag[/\Av?(\d+\.\d+\.\d+)\z/, 1]}.compact
end

def untagged_versions(name)
  (repository_versions(name) - tagged_versions(name)).sort_by{|version| Gem::Version.new(version)}
end

def untagged_findings(name, path)
  missing = untagged_versions(name)
  return [] if missing.empty?
  findings = []
  if missing.include?(declared_version(path))
    findings << "tags: the formula declares #{declared_version(path)} and the repository has no tag for it"
    missing -= [declared_version(path)]
  end
  return findings if missing.empty?
  findings << if missing.length == 1
    "tags: #{missing.first} has no tag"
  else
    "tags: #{missing.length} versions have no tag, #{missing.first} to #{missing.last}"
  end
  findings
end

# Reachability is asked of the branch by name rather than of HEAD.  A checkout
# left detached — at a tag, mid-bisect, mid-rebase — answers the question about
# wherever it is standing, under which every tag above that point reads as
# orphaned.  An auditor arriving at a verdict from the wrong question is the
# fault this tool exists to stop giving.
def branch?(name)
  git?(name, 'rev-parse', '--verify', '--quiet', "refs/heads/#{switches.branch}")
end

def reachable?(name, commit)
  ancestor?(name, commit, "refs/heads/#{switches.branch}")
end

def ancestor?(name, commit, of)
  git?(name, 'merge-base', '--is-ancestor', commit, of)
end

def object?(name, sha)
  git?(name, 'cat-file', '-e', "#{sha}^{commit}")
end

# One call per repository, this being the only thing here which touches the
# network, and the reason the check is asked for rather than assumed.
def remote_refs(name)
  @remote_refs ||= {}
  @remote_refs[name] ||= git(name, 'ls-remote', '--tags', '--heads', 'origin').lines.each_with_object({}) do |line, refs|
    sha, ref = line.split(/\s+/, 2)
    refs[ref.to_s.strip] = sha if sha && ref
  end
end

# The peeled line where there is one, an annotated tag naming a tag object and
# the commit being what a build checks out.  ls-remote answers it only where the
# pattern admits it, which is why nothing here queries a refname exactly.
def remote_tag_commit(name, tag)
  remote_refs(name)["refs/tags/#{tag}^{}"] || remote_refs(name)["refs/tags/#{tag}"]
end

def remote_branch_commit(name)
  remote_refs(name)["refs/heads/#{switches.branch}"]
end

def local_tag_commit(name, tag)
  git(name, 'rev-parse', "#{tag}^{commit}").strip
end

# A pinned url is fetched from origin, so origin is where the pin either resolves
# to the release it names or does not.  Everything else here reads this clone,
# which can be perfectly in order while origin serves something else: on 20260822
# fifty-eight tags across eight repositories named commits abandoned by a rewrite
# whose branch had been force-pushed and whose tags had not, and no check upon a
# clone could have seen one of them.
def remote_findings(name, path)
  return [] unless switches.origin?
  tag = declared_tag(path)
  return [] unless tag
  return ["origin: nothing answered, so what a pinned build would fetch is unknown"] if remote_refs(name).empty?
  remote = remote_tag_commit(name, tag)
  return ["origin: has no #{tag}, so the pin resolves in this clone and nowhere else"] unless remote
  findings = []
  local = local_tag_commit(name, tag)
  findings << "origin: #{tag} names #{remote[0, 7]} and this clone's names #{local[0, 7]}, so a build fetches something other than what is here" unless remote == local
  head = remote_branch_commit(name)
  if head.nil?
    findings << "origin: has no #{switches.branch}, so the pin cannot be told from what it releases from"
  elsif !object?(name, remote) || !object?(name, head)
    findings << "origin: #{tag} or #{switches.branch} is absent from this clone, so whether the pin sits upon that branch cannot be told without fetching"
  elsif !ancestor?(name, remote, head)
    findings << "origin: #{tag} names a commit outside #{switches.branch} there, which is what a pinned build fetches"
  end
  findings
end

def tree(name, revision)
  git(name, 'rev-parse', "#{revision}^{tree}").strip
end

# The commit the branch says is a version, found by its subject and not by its
# tag: the tag is the thing under suspicion, so asking it would be asking the
# accused.  Where a version is the subject of more than one commit the newest
# answers, summary_findings having already reported the duplication.
def branch_commit(name, version)
  line = git(name, 'log', '--format=%H %s', "refs/heads/#{switches.branch}").lines.find do |entry|
    entry.split(' ', 2).last.to_s.start_with?("#{version}: ")
  end
  line&.split(' ', 2)&.first
end

def orphaned_tags(name)
  tags(name).reject{|tag| reachable?(name, "#{tag}^{commit}")}
end

# Reachability finds the candidates; the tree decides which of them matter.  An
# --amend or a rewrite orphans a tag silently — git status says nothing, git tag
# still lists it, and it still resolves, to code outside the branch.  Where the
# tree is the same the tag is bookkeeping and is said so; where it differs the
# repository and the tag disagree about what that version was, and a pin there
# installs the version the rewrite abandoned, permanently, a pin not drifting.
def orphan_finding(name, tag)
  version = tag[/\Av?(\d+\.\d+\.\d+)\z/, 1]
  return "orphan: #{tag} names a commit outside #{switches.branch}" unless version
  commit = branch_commit(name, version)
  return "orphan: #{tag} names a commit outside #{switches.branch}, which has no commit saying #{version}" unless commit
  return "orphan: #{tag} names a commit outside #{switches.branch}, its tree being the tree of #{switches.branch}'s #{version}" if tree(name, tag) == tree(name, commit)
  "orphan: #{tag} names a different tree from #{switches.branch}'s #{version}, so a pin there installs what the repository has since abandoned"
end

def orphan_findings(name)
  return ["orphan: no #{switches.branch} branch, so no tag can be tested against the one released from"] unless branch?(name)
  orphaned_tags(name).collect{|tag| orphan_finding(name, tag)}
end

def version_finding(name, path)
  return nil unless repository_version(name)
  return nil if repository_version(name) == declared_version(path)
  "version: the formula says #{declared_version(path)} and the CHANGELOG says #{repository_version(name)}"
end

# A url naming no tag builds the default branch, so the declared version is a
# label rather than a pin and says nothing about what was installed.
def pin_finding(name, path)
  return 'url names no tag, so the build takes the default branch whatever the version says' unless declared_tag(path)
  return "url names #{declared_tag(path)}, which is not a tag in the repository" unless tags(name).include?(declared_tag(path))
  nil
end

# The fault pinning introduces, and the one every other check here passes over:
# a formula whose version and whose tag are each perfectly good and name
# different releases installs one while calling itself the other, which is the
# state pinning was adopted to make impossible.
def pin_version_finding(name, path)
  return nil unless declared_tag(path)
  return nil unless tags(name).include?(declared_tag(path))
  pinned = declared_tag(path)[/\Av?(\d+\.\d+\.\d+)\z/, 1]
  return nil unless pinned
  return nil if pinned == declared_version(path)
  "pin: the formula says #{declared_version(path)} and pins #{declared_tag(path)}"
end

def version_file_paths(name)
  git(name, 'ls-files').lines.collect(&:strip).grep(/VERSION\.rb\z/)
end

def stated_version(name, file)
  File.read(File.join(repository_path(name), file))[/VERSION\s*=\s*'([^']+)'/, 1]
end

def script_version(name)
  script = File.join(repository_path(name), 'bin', name)
  return nil unless File.exist?(script)
  File.read(script)[/^# (\d+\.\d+\.\d+)$/, 1]
end

# A version stated twice is a version which can disagree with itself.  startor's
# lib/Startor/VERSION.rb, which its gemspec reads, sat at 0.10.0 while the script
# header read 0.10.2: it was missed by one sweep and then by a substitution which
# looked for the version that sweep had skipped.  Only the header is obvious, so
# only the header gets maintained.
def secondary_version_findings(name, path)
  stated = version_file_paths(name).collect{|file| [file, stated_version(name, file)]}
  stated << ["bin/#{name}", script_version(name)] if script_version(name)
  stated.filter_map do |file, version|
    next if version.nil? || version == declared_version(path)
    "version: #{file} says #{version} and the formula says #{declared_version(path)}"
  end
end

# Both name the repository, and nothing holds them together.  git-autobisect's
# homepage named thoran/git-bisect, which does not exist, and should2expect's
# named thoran/dehashrocketify.
def homepage_finding(path)
  homepage = repository_named(declared_homepage(path))
  url = repository_named(declared_url(path))
  return nil unless homepage && url
  return nil if homepage == url
  "homepage: names #{homepage} and the url names #{url}"
end

def tracked?(name, file)
  !git(name, 'ls-files', '--', file).strip.empty?
end

def gitignore_lines(name)
  file = File.join(repository_path(name), '.gitignore')
  File.exist?(file) ? File.readlines(file).length : nil
end

# The files every repository here is meant to carry, each of which has been
# missing from one of them: gem-homepage had no .gitignore at all and startor a
# one-line one, and nineteen of the twenty declared a licence with no LICENSE
# beneath it.  None of these is found by installing the formula, which is why
# they went unnoticed for as long as they did.
def standard_file_findings(name, path)
  findings = []
  findings << 'README.md: none' unless tracked?(name, 'README.md')
  findings << 'README.md: no License section' if tracked?(name, 'README.md') && File.read(File.join(repository_path(name), 'README.md')) !~ /^## Licen[cs]e$/
  findings << 'LICENSE: none' unless tracked?(name, 'LICENSE')
  findings << 'CHANGELOG: none' unless changelog_path(name)
  findings << 'license: the formula declares none' unless formula_source(path) =~ /^\s*license '/
  lines = gitignore_lines(name)
  findings << '.gitignore: none' if lines.nil?
  findings << ".gitignore: #{lines} lines, the template being #{STANDARD_GITIGNORE_LINES}" if lines && lines < STANDARD_GITIGNORE_LINES
  findings
end

def installed?(directory, path)
  installed_paths(path).any?{|installed| installed == directory || installed.start_with?("#{directory}/")}
end

# The git-boot case: a directory added to the repository is absent from the
# bottle until an install line names it, and nothing but a Homebrew install
# shows that it is missing.
def directory_findings(name, path)
  (repository_directories(name) - UNINSTALLED_DIRECTORIES).reject{|directory| installed?(directory, path)}.collect do |directory|
    "#{directory}/ is in the repository and named by no install line"
  end
end

# Each resource is a gem name and the version its url names, the two being
# stated separately and so able to disagree.  A commented-out resource is not
# one, as with the install lines above.
def resources(path)
  @resources ||= {}
  @resources[path] ||= (
    result = {}
    gem_name = nil
    formula_source(path).lines.reject{|line| line.strip.start_with?('#')}.each do |line|
      if (declaration = line.match(/^\s*resource '([^']+)' do/))
        gem_name = declaration[1]
      elsif gem_name && (url = line.match(%r{url '.*/#{Regexp.escape(gem_name)}-([0-9][^']*)\.gem'}))
        result[gem_name] = url[1]
        gem_name = nil
      end
    end
    result
  )
end

# Which formulae vendor which version of what, across the whole tap.  Each
# formula declares its own resources, so the same gem is pinned once per
# formula and nothing holds the copies to the same version.
def resource_versions
  @resource_versions ||= formula_paths.each_with_object({}) do |path, result|
    resources(path).each do |gem_name, version|
      ((result[gem_name] ||= {})[version] ||= []) << formula_name(path)
    end
  end
end

def resource_finding(gem_name, versions)
  "#{gem_name}: " + versions.sort.collect{|version, names| "#{version} in #{names.sort.join(', ')}"}.join('; ')
end

# switches.rb was 0.9.15 in two formulae and 0.10.3 in two others, and 0.9.15 is
# the version which requires ostruct without declaring it.  Nothing says which
# is meant, so the drift is invisible until one of them fails.
def resource_findings
  @resource_findings ||= resource_versions.select{|_gem_name, versions| versions.length > 1}.collect do |gem_name, versions|
    resource_finding(gem_name, versions)
  end
end

def commits?(name)
  !git(name, 'rev-parse', '--verify', 'HEAD').strip.empty?
end

def dependencies(path)
  formula_source(path).lines.reject{|line| line.strip.start_with?('#')}.collect{|line| line[/^\s*depends_on '([^']+)'/, 1]}.compact
end

# Resources are fetched and installed by def install or they are not installed
# at all; declaring one asks Homebrew for nothing by itself.  moby declares
# switches.rb and mechanize and installs neither, so it resolves both from
# whichever gem home the invoking ruby happens to have — which is why its
# wrapper cannot set GEM_HOME without breaking it.
def unstaged_resource_finding(path)
  return nil if resources(path).empty?
  return nil if logical_lines(install_body(path)).any?{|statement| statement =~ /\bresources?\b/}
  "#{resources(path).length} resources declared and installed by nothing in def install, so they are resolved from whichever gem home the invoking ruby has"
end

# The interpreter the installed script actually names.  Not every formula wants
# depends_on 'ruby': gem-publish is a shell script and correctly declares
# nothing, so the question is whether what is declared matches what is asked for
# rather than whether anything is declared at all.
#
# sh and bash are not here, being present upon every machine this could install
# to and so wanted by nobody's depends_on.  A formula is asked to declare what
# Homebrew would otherwise have to find for it.
INTERPRETERS = %w{ruby python node perl}

def interpreter(name)
  binary = File.join(repository_path(name), 'bin', name)
  return nil unless File.exist?(binary)
  first = File.open(binary, &:gets).to_s
  return nil unless first.start_with?('#!')
  INTERPRETERS.find{|candidate| first.include?(candidate)}
end

def interpreter_finding(name, path)
  wanted = interpreter(name)
  return nil unless wanted
  return nil if dependencies(path).include?(wanted)
  "bin/#{name} is a #{wanted} script and the formula depends_on no #{wanted}"
end

# An unqualified name resolves against homebrew/core first, so depends_on 'moby'
# finds Docker's rather than this tap's.  A dependency upon a formula in this
# tap has to name the tap.
def unqualified_dependency_findings(path)
  dependencies(path).select{|dependency| !dependency.include?('/') && formula_names.include?(dependency)}.collect do |dependency|
    "depends_on '#{dependency}' names a formula in this tap unqualified, so it resolves against homebrew/core rather than here"
  end
end

def formula_names
  @formula_names ||= formula_paths.collect{|path| formula_name(path)}
end

# Three kinds of check: those reading what the repository tracks, those reading
# the working directory, and those reading only the formula.  A missing
# repository stops the first two and has nothing to say about the third, which
# 0.2.0 first got wrong by returning upon it.
#
# A repository without commits tracks nothing, so ls-files answers empty and the
# directory check passes upon having found nothing rather than upon there being
# nothing to find.  Said outright: a silent pass is the fault this tool exists
# to stop giving, and it is the same fault as the one it was written to catch.
# The tag finding is dropped with it, "not a tag in the repository" being true
# of a repository with no tags and no commits either, and the wrong reason.  The
# CHANGELOG is read from the working directory rather than from git, so the
# version check still has something to say.
def search_directories
  @search_directories ||= switches.search_path.split(File::PATH_SEPARATOR).reject(&:empty?)
end

def brew_bin
  @brew_bin ||= File.join(switches.brew_prefix, 'bin')
end

# Everything searched before Homebrew's own bin.  A formula installs to that bin
# and nowhere earlier, so anything of the same name found before it is what the
# name actually runs.
def directories_ahead_of_brew
  return [] unless search_directories.include?(brew_bin)
  search_directories[0...search_directories.index(brew_bin)]
end

# The consumer half.  A formula can be correct in every other respect and still
# never be what runs: a gem shim in ~/.gem or a copy in ~/bin sits earlier on
# the path and answers to the name instead.  moby had exactly this during the
# session which produced this tool — the shim answered and was itself broken —
# and it is invisible from the tap, which is why nothing else here would find
# it.
def shadow_finding(name)
  shadow = directories_ahead_of_brew.find{|directory| File.exist?(File.join(directory, name))}
  return nil unless shadow
  "#{File.join(shadow, name)} is searched before #{brew_bin}, so it answers to the name and the formula's own copy never runs"
end

def tap_readme
  @tap_readme ||= (
    path = File.join(formulae_directory, 'README.md')
    File.exist?(path) ? File.read(path) : false
  )
end

def installed_names
  tap_readme.to_s.scan(/^\$ brew install (?:thoran\/tap\/)?([a-z0-9_.-]+)$/).flatten
end

def sourced_names
  tap_readme.to_s.scan(/^\[([a-z0-9_.-]+)\]\(https:\/\/github\.com\/thoran\//).flatten
end

# The tap's own README states the formulae twice, as a line to run and as a link
# to the source, and a formula added or renamed leaves both saying what the tap
# no longer holds.  Reported apart from the per-formula findings for the reason
# the resource check is: naming one formula would be naming the wrong thing,
# the fault belonging to the README rather than to any formula in it.
def readme_findings
  names = formula_paths.collect{|path| formula_name(path)}
  return [] if names.empty?
  return ['no README.md in the tap'] unless tap_readme
  [['the install list', installed_names], ['the sources list', sourced_names]].flat_map do |label, listed|
    findings = []
    findings << "#{label} does not name #{(names - listed).join(', ')}" unless (names - listed).empty?
    findings << "#{label} names #{(listed - names).join(', ')}, which is no formula here" unless (listed - names).empty?
    findings
  end
end

def formula_only_findings(path)
  [*unrecognised_findings(path), unstaged_resource_finding(path), *unqualified_dependency_findings(path), homepage_finding(path)].compact
end

def findings_for(name, path)
  formula_only = [*formula_only_findings(path), shadow_finding(name)].compact
  return ["no repository at #{repository_path(name)}", *formula_only] unless repository?(name)
  unless commits?(name)
    return ['the repository has no commits, so what it tracks and what it tags cannot be read', version_finding(name, path), *formula_only].compact
  end
  [version_finding(name, path), *secondary_version_findings(name, path), pin_finding(name, path), pin_version_finding(name, path), *directory_findings(name, path), interpreter_finding(name, path), unreadable_changelog_finding(name), *summary_findings(name), *untagged_findings(name, path), *orphan_findings(name), *remote_findings(name, path), *standard_file_findings(name, path), *formula_only].compact
end

def findings
  @findings ||= formula_paths.each_with_object({}) do |path, result|
    found = findings_for(formula_name(path), path)
    result[formula_name(path)] = found unless found.empty?
  end
end

def report
  findings.each do |name, list|
    puts name
    list.each{|finding| puts "  #{finding}"}
  end
end

# Reported apart from the rest, a gem pinned twice being a fault of the tap
# rather than of any one formula in it: naming either formula would be naming
# the wrong half of the disagreement.
def report_resources
  return if resource_findings.empty?
  puts
  puts 'the same gem at more than one version'
  resource_findings.each{|finding| puts "  #{finding}"}
end

def report_readme
  return if readme_findings.empty?
  puts
  puts "the tap's own README"
  readme_findings.each{|finding| puts "  #{finding}"}
end

def report_summary
  puts unless findings.empty? && resource_findings.empty? && readme_findings.empty?
  puts "#{findings.length} of #{formula_paths.length} formulae have something to answer for, " \
    "#{resource_findings.length} #{resource_findings.length == 1 ? 'gem is' : 'gems are'} pinned at more than one version, " \
    "and the tap's README has #{readme_findings.length} #{readme_findings.length == 1 ? 'thing' : 'things'} to answer for."
end

def anything_found?
  !findings.empty? || !resource_findings.empty? || !readme_findings.empty?
end

def main
  switches
  validate_directories
  report
  report_resources
  report_readme
  report_summary
  exit 1 if anything_found?
end

main

#!/usr/bin/env ruby
# tap-audit

# 20260817
# 0.2.0

require 'switches.rb'

DEFAULT_REPOSITORIES_DIRECTORY = File.expand_path('..')
DEFAULT_TAP_DIRECTORY = File.expand_path('.')
UNINSTALLED_DIRECTORIES = %w{doc spec test}

def usage
  puts "tap-audit - Report what each formula in the tap has drifted from."
  puts
  puts "Usage: tap-audit [options]"
  puts
  puts "Options:"
  puts "  -r, --repositories DIR  Where the source repositories are (default: #{DEFAULT_REPOSITORIES_DIRECTORY})"
  puts "  -f, --formulae DIR      Where the formulae are (default: #{DEFAULT_TAP_DIRECTORY})"
  puts "  -h, --help              Show this help"
  puts
  puts "Exits 1 where anything was found, so it can gate a release."
end

def switches
  @switches ||= Switches.new do |s|
    s.optional(:r, :repositories, default: DEFAULT_REPOSITORIES_DIRECTORY){'Where the source repositories are'}
    s.optional(:f, :formulae, default: DEFAULT_TAP_DIRECTORY){'Where the formulae are'}
    s.perform(:h, :help?) do
      usage
      exit
    end
  end
end

def validate_directories
  [switches.repositories, switches.formulae].each do |directory|
    unless Dir.exist?(directory)
      $stderr.puts "No such directory: #{directory}"
      exit 1
    end
  end
end

def formula_paths
  @formula_paths ||= Dir[File.join(switches.formulae, '*.rb')].sort
end

def formula_name(path)
  File.basename(path, '.rb')
end

def formula_source(path)
  @formula_sources ||= {}
  @formula_sources[path] ||= File.read(path)
end

def declared_version(path)
  formula_source(path)[/^\s*version '([^']+)'/, 1]
end

def declared_tag(path)
  formula_source(path)[/^\s*url .*tag: '([^']+)'/, 1]
end

# A formula reaches the keg by more than .install: moby copied its lib in with
# FileUtils.cp_r, which 0.0.0 did not read and so reported a lib named by no
# install line where the lib was in fact installed, wrongly and by another
# means.  Anything which puts a path into the keg is an install line here.
# Commented-out lines are not, and skyhooks carries four of them.
def install_lines(path)
  formula_source(path).lines.reject{|line| line.strip.start_with?('#')}.select{|line| line =~ /\.install\b|\bcp_r?\b|\bmv\b|\bln_s\b/}
end

# Both quotings, since an interpolated path cannot be single-quoted and
# FileUtils.cp_r("#{pwd}/lib", lib) is how the one which was missed was written.
def quoted_strings(line)
  line.scan(/'([^']*)'|"([^"]*)"/).flatten.compact
end

# What is left of a string once the interpolations are dropped, being the part
# which names a path within the repository.  "#{pwd}/lib" is lib, and a leading
# separator left behind by the interpolation is not a path from the root.
def repository_relative(string)
  string.gsub(/\#\{[^}]*\}/, '').sub(%r{\A/+}, '').sub(%r{/+\z}, '')
end

# The lines of def install, comments and blanks dropped.  The end which closes
# the method is the one at the method's own indent, a deeper one closing a block
# within it.
def install_body(path)
  @install_body ||= {}
  @install_body[path] ||= (
    body = []
    depth = nil
    formula_source(path).lines.each do |line|
      if depth.nil?
        depth = line[/\A */].length if line =~ /^\s*def install\b/
        next
      end
      break if line =~ /\A\s{#{depth}}end\s*\z/
      body << line
    end
    body.reject{|line| line.strip.empty? || line.strip.start_with?('#')}
  )
end

# A statement is finished where nothing is left open and nothing is left
# dangling.  Three things carry a statement onto the next line here:
# write_env_script's parentheses, resources.each's do, and the trailing comma of
# a system call's argument list.  Each of the three is in the tap already, and a
# statement rejoined wrongly is a statement reported as unrecognised, so this
# decides the false positives rather than the whitelist does.
def continued?(text)
  text.count('(') != text.count(')') ||
    text.count('{') != text.count('}') ||
    text.scan(/\bdo\b/).length != text.scan(/\bend\b/).length ||
    text.strip.end_with?(',')
end

def logical_lines(lines)
  statements = []
  pending = ''
  lines.each do |line|
    pending += line
    next if continued?(pending)
    statements << pending.strip
    pending = ''
  end
  statements << pending.strip unless pending.strip.empty?
  statements
end

INSTALL_IDIOMS = [
  /\.install\b/,
  /\bFileUtils\.\w+/,
  /\Asystem\b/,
  /\AENV\[/,
  /\Aresources\b/,
  /\bwrite_env_script\b/,
]

def recognised?(statement)
  INSTALL_IDIOMS.any?{|idiom| statement =~ idiom}
end

# The check which finds a FileUtils.cp_r without anyone having thought of
# FileUtils.cp_r.  What def install does decides what reaches the keg, so a
# statement this cannot classify is one whose effect upon the keg is unknown,
# and saying so is the whole of the job.  Silence in its place is how 0.0.0
# reported moby's lib as named by no install line while it was being installed
# by a means not looked for.
def unrecognised_findings(path)
  logical_lines(install_body(path)).reject{|statement| recognised?(statement)}.collect do |statement|
    "unrecognised in def install, so what it puts in the keg is unknown: #{statement.lines.first.strip}"
  end
end

def installed_paths(path)
  install_lines(path).flat_map{|line| quoted_strings(line)}.collect{|s| repository_relative(s)}.reject(&:empty?)
end

def repository_path(name)
  File.join(switches.repositories, name)
end

def repository?(name)
  Dir.exist?(File.join(repository_path(name), '.git'))
end

def git(name, *arguments)
  IO.popen(['git', '-C', repository_path(name), *arguments], err: File::NULL, &:read)
end

def tags(name)
  git(name, 'tag', '--list').lines.map(&:strip)
end

# The top-level directory of every tracked file, which is what an install line
# names.  A file tracked at the root belongs to no directory and is left out.
def repository_directories(name)
  git(name, 'ls-files').lines.map{|path| path.strip.split('/').first if path.include?('/')}.compact.uniq.sort
end

def changelog_path(name)
  Dir[File.join(repository_path(name), 'CHANGELOG*')].first
end

# The newest entry, the CHANGELOGs being written newest-first and the version
# test in each repository asserting that the two agree.
def repository_version(name)
  return nil unless changelog_path(name)
  File.read(changelog_path(name))[/^(\d+\.\d+\.\d+):/, 1]
end

def version_finding(name, path)
  return nil unless repository_version(name)
  return nil if repository_version(name) == declared_version(path)
  "version: the formula says #{declared_version(path)} and the CHANGELOG says #{repository_version(name)}"
end

# A url naming no tag builds the default branch, so the declared version is a
# label rather than a pin and says nothing about what was installed.
def pin_finding(name, path)
  return 'url names no tag, so the build takes the default branch whatever the version says' unless declared_tag(path)
  return "url names #{declared_tag(path)}, which is not a tag in the repository" unless tags(name).include?(declared_tag(path))
  nil
end

def installed?(directory, path)
  installed_paths(path).any?{|installed| installed == directory || installed.start_with?("#{directory}/")}
end

# The git-boot case: a directory added to the repository is absent from the
# bottle until an install line names it, and nothing but a Homebrew install
# shows that it is missing.
def directory_findings(name, path)
  (repository_directories(name) - UNINSTALLED_DIRECTORIES).reject{|directory| installed?(directory, path)}.collect do |directory|
    "#{directory}/ is in the repository and named by no install line"
  end
end

# Each resource is a gem name and the version its url names, the two being
# stated separately and so able to disagree.  A commented-out resource is not
# one, as with the install lines above.
def resources(path)
  @resources ||= {}
  @resources[path] ||= (
    result = {}
    gem_name = nil
    formula_source(path).lines.reject{|line| line.strip.start_with?('#')}.each do |line|
      if (declaration = line.match(/^\s*resource '([^']+)' do/))
        gem_name = declaration[1]
      elsif gem_name && (url = line.match(%r{url '.*/#{Regexp.escape(gem_name)}-([0-9][^']*)\.gem'}))
        result[gem_name] = url[1]
        gem_name = nil
      end
    end
    result
  )
end

# Which formulae vendor which version of what, across the whole tap.  Each
# formula declares its own resources, so the same gem is pinned once per
# formula and nothing holds the copies to the same version.
def resource_versions
  @resource_versions ||= formula_paths.each_with_object({}) do |path, result|
    resources(path).each do |gem_name, version|
      ((result[gem_name] ||= {})[version] ||= []) << formula_name(path)
    end
  end
end

def resource_finding(gem_name, versions)
  "#{gem_name}: " + versions.sort.collect{|version, names| "#{version} in #{names.sort.join(', ')}"}.join('; ')
end

# switches.rb was 0.9.15 in two formulae and 0.10.3 in two others, and 0.9.15 is
# the version which requires ostruct without declaring it.  Nothing says which
# is meant, so the drift is invisible until one of them fails.
def resource_findings
  @resource_findings ||= resource_versions.select{|_gem_name, versions| versions.length > 1}.collect do |gem_name, versions|
    resource_finding(gem_name, versions)
  end
end

# Two kinds of check: those which read the repository and those which read only
# the formula.  A missing repository stops the first and has nothing to say
# about the second, which 0.2.0 first got wrong by returning upon it.
def findings_for(name, path)
  formula_only = unrecognised_findings(path)
  return ["no repository at #{repository_path(name)}", *formula_only] unless repository?(name)
  [version_finding(name, path), pin_finding(name, path), *directory_findings(name, path), *formula_only].compact
end

def findings
  @findings ||= formula_paths.each_with_object({}) do |path, result|
    found = findings_for(formula_name(path), path)
    result[formula_name(path)] = found unless found.empty?
  end
end

def report
  findings.each do |name, list|
    puts name
    list.each{|finding| puts "  #{finding}"}
  end
end

# Reported apart from the rest, a gem pinned twice being a fault of the tap
# rather than of any one formula in it: naming either formula would be naming
# the wrong half of the disagreement.
def report_resources
  return if resource_findings.empty?
  puts
  puts 'the same gem at more than one version'
  resource_findings.each{|finding| puts "  #{finding}"}
end

def report_summary
  puts unless findings.empty? && resource_findings.empty?
  puts "#{findings.length} of #{formula_paths.length} formulae have something to answer for, " \
    "and #{resource_findings.length} #{resource_findings.length == 1 ? 'gem is' : 'gems are'} pinned at more than one version."
end

def anything_found?
  !findings.empty? || !resource_findings.empty?
end

def main
  switches
  validate_directories
  report
  report_resources
  report_summary
  exit 1 if anything_found?
end

main
